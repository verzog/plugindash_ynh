#!/bin/bash

#=================================================
# IMPORT GENERIC HELPERS
#=================================================

source _common.sh
source /usr/share/yunohost/helpers

#=================================================
# STOP THE TIMER WHILE UPGRADING
#=================================================
ynh_script_progression "Pausing the daily check..."

systemctl stop "$app.timer" 2>/dev/null || true
systemctl stop "$app.service" 2>/dev/null || true
systemctl stop "$app-run.service" 2>/dev/null || true

#=================================================
# ENSURE DOWNWARD COMPATIBILITY
#=================================================
ynh_script_progression "Ensuring downward compatibility..."

plugindash_set_defaults

# Installs before 1.2.1 got just "release.yml" as the default, which hid the collector's own default of
# also ignoring "Dependabot Updates". Add it only if the setting was never changed from that old default.
if [ "$ci_ignore_workflows" = "release.yml" ]; then
    ci_ignore_workflows="release.yml, Dependabot Updates"
    ynh_app_setting_set --key=ci_ignore_workflows --value="$ci_ignore_workflows"
fi

# ynh_app_setting_set_default also updates the variables, so every setting is now loaded.

#=================================================
# UPGRADE THE APP
#=================================================
ynh_script_progression "Upgrading the dashboard files..."

plugindash_deploy_code

#=================================================
# UPDATE CONFIGURATION
#=================================================
ynh_script_progression "Updating the configuration..."

plugindash_write_config

#=================================================
# SYSTEM CONFIGURATION
#=================================================
ynh_script_progression "Upgrading the web server and timer configuration..."

plugindash_add_nginx
plugindash_add_systemd

#=================================================
# END OF SCRIPT
#=================================================

ynh_script_progression "Upgrade of $app completed"
