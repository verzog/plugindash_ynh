[Unit]
Description=Plugin Dashboard: on-demand "Run check now" endpoint (__APP__)
Documentation=https://github.com/verzog/plugindash_ynh
After=network.target

[Service]
Type=simple
User=__APP__
Group=__APP__
UMask=0027
WorkingDirectory=__INSTALL_DIR__/app
Environment=PLUGINDASH_RUN_PORT=__PORT__
ExecStart=/usr/bin/python3 -I -B __INSTALL_DIR__/app/run.py --config __INSTALL_DIR__/config.json serve-run
Restart=on-failure
RestartSec=5
# A run it started is detached, so don't kill it when this endpoint restarts.
KillMode=process
Nice=10

# Same sandbox as the collector: it listens on localhost and spawns the collector,
# which needs the network, the web root and the data folder.
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=__INSTALL_DIR__/www __DATA_DIR__
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
CapabilityBoundingSet=

[Install]
WantedBy=multi-user.target
